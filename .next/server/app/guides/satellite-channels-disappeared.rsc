b:[["$","$L15",null,{}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"لماذا اختفت القنوات من الرسيفر؟\",\"description\":\"أسباب اختفاء القنوات من الرسيفر وكيفية إعادة البحث وتحديث الترددات، ومتى تحتاج إعادة برمجة.\",\"inLanguage\":\"ar-SA\",\"mainEntityOfPage\":\"https://bestdishelectronics.store/guides/satellite-channels-disappeared\",\"author\":{\"@type\":\"Organization\",\"name\":\"محل حسن للإلكترونيات\"},\"publisher\":{\"@id\":\"https://bestdishelectronics.store/#business\"}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"تغيير التردد من جهة القناة\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"المحطات تحدّث تردداتها دورياً. الحل إعادة البحث عن القنوات من قائمة الرسيفر (Auto Scan) أو إضافة التردد الجديد يدوياً ثم البحث.\"}},{\"@type\":\"Question\",\"name\":\"حذف عرضي أو إعادة ضبط المصنع\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"انقطاع الكهرباء المفاجئ أو ضغط زر إعادة الضبط قد يمسح قائمة القنوات. في هذه الحالة تحتاج إعادة برمجة كاملة وترتيب القنوات من جديد.\"}},{\"@type\":\"Question\",\"name\":\"ضعف إشارة على قمر معيّن\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"إذا اختفت قنوات قمر كامل (مثل عرب سات) وبقيت قنوات نايل سات، فغالباً وحدة الـ LNB الخاصة بذلك القمر أو اتجاه ذراعها يحتاج ضبطاً.\"}},{\"@type\":\"Question\",\"name\":\"قنوات مشفّرة\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"بعض القنوات تتحول إلى التشفير وتتطلب اشتراكاً نظامياً. اختفاؤها من الباقة المجانية أمر خارج عن الدش والرسيفر.\"}}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"الرئيسية\",\"item\":\"https://bestdishelectronics.store/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"الدليل\",\"item\":\"https://bestdishelectronics.store/guides\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"لماذا اختفت القنوات من الرسيفر؟\",\"item\":\"https://bestdishelectronics.store/guides/satellite-channels-disappeared\"}]}"}}],["$","main",null,{"dir":"rtl","children":[["$","$L16",null,{"items":[{"name":"الرئيسية","href":"/"},{"name":"الدليل","href":"/guides"},{"name":"لماذا اختفت القنوات من الرسيفر؟"}]}],["$","article",null,{"className":"mx-auto max-w-3xl px-6 py-10","children":[["$","h1",null,{"className":"mb-4 text-3xl font-extrabold leading-snug text-gray-900","children":"لماذا اختفت القنوات من الرسيفر؟"}],["$","p",null,{"className":"mb-8 text-lg leading-relaxed text-gray-700","children":"اختفاء قناة أو مجموعة قنوات لا يعني بالضرورة عطلاً في الدش. كثيراً ما تغيّر المحطات تردداتها أو تنقلها إلى قمر آخر، فتختفي من قائمة الرسيفر حتى تعيد البحث."}],[["$","section","0",{"className":"mb-8","children":[["$","h2",null,{"className":"mb-3 text-xl font-bold text-gray-900","children":"تغيير التردد من جهة القناة"}],[["$","p","0",{"className":"mb-3 leading-relaxed text-gray-700","children":"المحطات تحدّث تردداتها دورياً. الحل إعادة البحث عن القنوات من قائمة الرسيفر (Auto Scan) أو إضافة التردد الجديد يدوياً ثم البحث."}]]]}],["$","section","1",{"className":"mb-8","children":[["$","h2",null,{"className":"mb-3 text-xl font-bold text-gray-900","children":"حذف عرضي أو إعادة ضبط المصنع"}],[["$","p","0",{"className":"mb-3 leading-relaxed text-gray-700","children":"انقطاع الكهرباء المفاجئ أو ضغط زر إعادة الضبط قد يمسح قائمة القنوات. في هذه الحالة تحتاج إعادة برمجة كاملة وترتيب القنوات من جديد."}]]]}],["$","section","2",{"className":"mb-8","children":[["$","h2",null,{"className":"mb-3 text-xl font-bold text-gray-900","children":"ضعف إشارة على قمر معيّن"}],["$L17"]]}],"$L18"],"$L19","$L1a","$L1b"]}],"$L1c"]}],"$L1d"]
