a:[["$","$L14",null,{}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"أسباب ضعف إشارة الدش وكيفية حلها\",\"description\":\"لماذا تضعف إشارة الدش ويحدث تقطيع في القنوات، وما الفرق بين مؤشر القوة ومؤشر الجودة.\",\"inLanguage\":\"ar-SA\",\"mainEntityOfPage\":\"https://bestdishelectronics.store/guides/weak-satellite-signal\",\"author\":{\"@type\":\"Organization\",\"name\":\"محل حسن للإلكترونيات\"},\"publisher\":{\"@id\":\"https://bestdishelectronics.store/#business\"}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"الطقس والغيوم الكثيفة\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"الأمطار الغزيرة والغيوم السميكة تضعف الإشارة مؤقتاً. إذا كان التقطيع يحدث فقط وقت المطر ويزول بعده، فالنظام سليم لكن هامش الجودة منخفض ويمكن تحسينه بضبط أدق أو LNB أفضل.\"}},{\"@type\":\"Question\",\"name\":\"اتساخ أو انحناء الطبق\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"تراكم الغبار والأتربة، أو انثناء حافة الطبق، يشتّت الإشارة. تنظيف الطبق وتقويم أي انبعاج يعيد جزءاً من الجودة.\"}},{\"@type\":\"Question\",\"name\":\"كابل رديء أو طويل جداً\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"الكابل القديم أو ذو المقطع الصغير يفقد جزءاً من الإشارة، خصوصاً في المسافات الطويلة. استخدام كابل RG6 نحاسي جيد وتقليل الوصلات يحسّن النتيجة.\"}},{\"@type\":\"Question\",\"name\":\"ضعف ضبط الاتجاه\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"فرق درجة واحدة في زاوية الطبق قد ينزل الجودة من 90% إلى 50%. الضبط بجهاز قياس إشارة (Sat Finder) يصل بالطبق إلى أعلى قيمة ممكنة.\"}}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"الرئيسية\",\"it