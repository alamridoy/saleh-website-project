{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/services/service1",
      "regex": "^/services/service1(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/service1(?:/)?$"
    },
    {
      "page": "/services/service2",
      "regex": "^/services/service2(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/service2(?:/)?$"
    },
    {
      "page": "/services/service3",
      "regex": "^/services/service3(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/service3(?:/)?$"
    },
    {
      "page": "/services/service4",
      "regex": "^/services/service4(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/service4(?:/)?$"
    },
    {
      "page": "/services/service5",
      "regex": "^/services/service5(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/service5(?:/)?$"
    },
    {
      "page": "/services/service6",
      "regex": "^/services/service6(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/service6(?:/)?$"
    },
    {
      "page": "/services/service7",
      "regex": "^/services/service7(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/service7(?:/)?$"
    },
    {
      "page": "/services/service8",
      "regex": "^/services/service8(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/service8(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}